# Any remote database must carry sslmode=verify-full — the server refuses to
# start otherwise. Weaker modes (require, prefer, verify-ca) are verified only
# by accident of the current pg release and stop being verified in pg v9.
# A localhost database is exempt; there is no certificate to verify.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full
DATABASE_POOL_SIZE=25
SLOW_QUERY_THRESHOLD_MS=100
SLOW_REQUEST_THRESHOLD_MS=200
PORT=4000
FRONTEND_URL=http://localhost:3000
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=you@example.com
# Error tracking (optional). Leave SENTRY_DSN empty to disable Sentry.
SENTRY_DSN=
# Set to true to expose GET /debug-sentry for verifying a deliberate 500.
SENTRY_DEBUG=false

# Shared with the frontend — this exact value must match frontend/.env.local.
# It verifies the JWT bridge. NOTE: this one is NOT in the Zod schema in
# config.ts, so a wrong or missing value does not stop the server booting; it
# surfaces as a 500 MISSING_SECRET on the first authenticated request.
NEXTAUTH_SECRET=

# Ask AI natural-language roll. The route returns 503 when unset; everything
# else keeps working.
GEMINI_API_KEY=

# Bearer token guarding /api/metrics/*. Those endpoints 503 when unset.
METRICS_TOKEN=

# Rate-limit knobs. Defaults shown; RATE_LIMIT_DISABLED=true turns it off.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=300
RATE_LIMIT_MAX_PER_USER=600
RATE_LIMIT_DISABLED=false

# Recommender scoring knobs, read by lib/experiments.ts (not by config.ts).
# Retune the ranker without a redeploy; A/B variants layer overrides on top.
REC_QUALITY_WEIGHT=0.8
REC_RECENCY_WEIGHT=0.15
REC_MMR_LAMBDA=0.7
