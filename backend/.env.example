# Any remote database must carry sslmode=verify-full — the server refuses to
# start otherwise. Weaker modes (require, prefer, verify-ca) are verified only
# by accident of the current pg release and stop being verified in pg v9.
# A localhost database is exempt; there is no certificate to verify.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full
DATABASE_POOL_SIZE=25
SLOW_QUERY_THRESHOLD_MS=100
SLOW_REQUEST_THRESHOLD_MS=200
PORT=4000
FRONTEND_URL=http://localhost:3000
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=you@example.com
# Error tracking (optional). Leave SENTRY_DSN empty to disable Sentry.
SENTRY_DSN=
# Set to true to expose GET /debug-sentry for verifying a deliberate 500.
SENTRY_DEBUG=false
