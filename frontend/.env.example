NEXT_PUBLIC_API_URL=http://localhost:4000
# This app opens its own pool for auth and lists, so it needs the database too.
# Same rule as the backend: a remote host must carry sslmode=verify-full, or the
# Prisma client refuses to be created. A localhost database is exempt.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full
# Error tracking (optional). Set by the @sentry/nextjs wizard; leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Google Search Console ownership token (production only). The value from the
# "HTML tag" verification method — the content attribute, not the whole tag.
# Leave empty locally and on previews so they don't claim the production property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Must be the exact same value as the backend's — this is the JWT bridge.
NEXTAUTH_SECRET=

# Google OAuth sign-in. Add the callback URL in the Google console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Password-reset emails (the mailed one-time link). Sign-in itself is
# email + password or Google; there is no email OTP flow.
RESEND_API_KEY=
EMAIL_FROM=

# Canonical URL for SEO/OG tags. Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
